# Copy this file to .env and fill in your keys. Never commit .env.
TELEM_API_KEY=
TAVILY_API_KEY=
ANTHROPIC_API_KEY=
# Optional: which Telem search engines to use, e.g. tavily,exa,brave (blank = Telem's defaults)
TELEM_PROVIDERS=
# The hackathon uses its own Telem address (leave blank for the standard one)
TELEM_BASE_URL=https://hack.telem.ai/api
